{
  "name": "@dsh-external/dsh-proxy-monitor",
  "version": "0.2.0",
  "description": "订阅反代 + 额度监控：把 Codex / Antigravity / WorkBuddy / Grok 的订阅账号接入 DSH（LLM 路由 + 生图 + 活体模型目录 + 专属设置），并在侧栏用圆环展示各 provider 的额度消耗",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nomit8088/dsh-proxy-monitor.git"
  },
  "homepage": "https://github.com/Nomit8088/dsh-proxy-monitor#readme",
  "bugs": {
    "url": "https://github.com/Nomit8088/dsh-proxy-monitor/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quota",
    "usage-monitor",
    "reverse-proxy",
    "codex",
    "antigravity",
    "workbuddy",
    "grok"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "tsdown",
    "test": "node scripts/test-frame.mjs && node scripts/test-transition.mjs && node scripts/test-accounts.mjs && node scripts/test-grok-account.mjs && node scripts/test-codex-account.mjs && node scripts/test-antigravity-account.mjs && node scripts/test-antigravity-models.mjs && node scripts/test-catalog-preferences.mjs && node scripts/test-workbuddy-encrypted-auth.mjs && node scripts/test-workbuddy-catalog.mjs",
    "probe": "node scripts/probe.mjs",
    "inspect:css": "node scripts/inspect-css.mjs",
    "preview:shape": "node scripts/preview-shape.mjs",
    "link:types": "node scripts/link-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.0 <2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.2 <1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@earendil-works/pi-ai": ">=0.82.0 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "dependencies": {
    "undici": "^8.11.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  }
}
